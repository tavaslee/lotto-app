# 好報樂透資訊平台 06e31472 — 安全環境變數範本
# 請複製為 .env，填入自己的值；切勿提交或分享實際密鑰。

# Runtime
NODE_ENV=development
PORT=3000

# SQL database（會員、權限快取與登入相關資料）
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME

# Session / authentication
JWT_SECRET=請替換為至少32字元的高強度隨機字串
VITE_APP_ID=請填入OAuth應用程式ID
OAUTH_SERVER_URL=https://your-oauth-server.example.com
VITE_OAUTH_PORTAL_URL=https://your-oauth-portal.example.com
OWNER_OPEN_ID=請填入網站擁有者識別碼
OAUTH_SERVER_URL=http://localhost:3000

# Manus built-in API / object storage（在 Manus 專案中通常由平台自動注入）
BUILT_IN_FORGE_API_URL=https://your-forge-api.example.com
BUILT_IN_FORGE_API_KEY=請填入伺服器端API金鑰
VITE_FRONTEND_FORGE_API_URL=https://your-frontend-forge-api.example.com
VITE_FRONTEND_FORGE_API_KEY=請填入前端API金鑰

# Google Sheets：「樂透開獎資料」
GOOGLE_SHEETS_SPREADSHEET_ID=請填入試算表網址中的ID
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
# 使用單一環境變數字串，換行以 \n 表示。
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

